# DutyBack settings. Copy to .env in this folder, or put .env one folder up
# (the app reads ./.env first, then ../.env). Never commit a real .env.

# ---- API key: use ONE of these (names must be spelled exactly like this) ----
# Course key (Portkey). The app uses gpt-6-luna only on this key.
PORTKEY_API_KEY=
# Or your own OpenAI key (model set by DUTYBACK_OPENAI_MODEL, default gpt-6-luna)
OPENAI_API_KEY=

# Which engine runs the agents:
#   auto    = PORTKEY_API_KEY, else OPENAI_API_KEY, else a Claude Code login, else demo mode
#   portkey | openai | claude  = force one
DUTYBACK_BACKEND=auto

# auto = live if an engine is available, otherwise demo (replays recorded runs) | live | demo
DUTYBACK_MODE=auto

# Claude models, used only when DUTYBACK_BACKEND=claude
DUTYBACK_READER_MODEL=opus
DUTYBACK_CHECKER_MODEL=sonnet
DUTYBACK_ADVISOR_MODEL=sonnet

# Spending guards
DUTYBACK_MAX_USD_PER_CALL=1.50
DUTYBACK_MAX_RUNS_PER_DAY=40

# Demo-mode replay speed (higher = faster)
DUTYBACK_REPLAY_SPEED=8

PORT=8010
